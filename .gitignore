data/*
!data/.gitkeep
*.csv

# Kaggle 認証情報(絶対にコミットしない)
kaggle.json
.kaggle/

# Python のキャッシュ・仮想環境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 生成物
submission*.csv
*.pkl

# OS / エディタ
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
